<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Nickelony.LanguageServer.Lua</RootNamespace>
    <AssemblyName>Nickelony.LanguageServer.Lua</AssemblyName>
    <PackageId>Nickelony.LanguageServer.Lua</PackageId>
    <Authors>Kewin Kupilas</Authors>
    <Description>Lightweight Lua language-server provider for the Nickelony Language Server family, backed by LuaLS.</Description>
    <PackageTags>language-server;lsp;lua;intellisense;nickelony</PackageTags>
    <RepositoryUrl>https://github.com/Nickelony/LanguageServer</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Version>0.1.0-preview</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>LanguageServer.png</PackageIcon>
    <Copyright>Copyright (c) 2026 Kewin Kupilas</Copyright>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nickelony.LanguageServer.Abstractions\Nickelony.LanguageServer.Abstractions.csproj" />
    <ProjectReference Include="..\Nickelony.LanguageServer.Client\Nickelony.LanguageServer.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\Icon\LanguageServer.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>