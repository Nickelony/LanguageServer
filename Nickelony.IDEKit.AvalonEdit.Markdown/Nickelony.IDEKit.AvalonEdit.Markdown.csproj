<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Nickelony.IDEKit.AvalonEdit.Markdown</RootNamespace>
    <AssemblyName>Nickelony.IDEKit.AvalonEdit.Markdown</AssemblyName>
    <PackageId>Nickelony.IDEKit.AvalonEdit.Markdown</PackageId>
    <Description>Markdown tooltip rendering for AvalonEdit editors: a Markdig-backed renderer that produces WPF FlowDocuments and embedded code-block editors.</Description>
    <PackageTags>text-editor;editor;avaloneditor;wpf;markdown;tooltip;nickelony</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>CS1591;RS0016;RS0017</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\Infrastructure\BrushHelpers.cs" Link="Infrastructure\BrushHelpers.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nickelony.IDEKit.AvalonEdit.Markdown.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\Icon\LanguageServer.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
