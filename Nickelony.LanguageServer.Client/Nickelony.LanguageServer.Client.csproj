<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Nickelony.LanguageServer.Client</RootNamespace>
    <AssemblyName>Nickelony.LanguageServer.Client</AssemblyName>
    <PackageId>Nickelony.LanguageServer.Client</PackageId>
    <Authors>Kewin Kupilas</Authors>
    <Description>Lightweight LSP client for .NET built on StreamJsonRpc - spawns a language-server process and speaks LSP over stdio.</Description>
    <PackageTags>language-server;lsp;editor;intellisense;nickelony</PackageTags>
    <RepositoryUrl>https://github.com/Nickelony/LanguageServer</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Version>0.1.0-preview</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>LanguageServer.png</PackageIcon>
    <Copyright>Copyright (c) 2026 Kewin Kupilas</Copyright>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.*" />
    <PackageReference Include="StreamJsonRpc" Version="2.24.84" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nickelony.LanguageServer.Abstractions\Nickelony.LanguageServer.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\Icon\LanguageServer.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
