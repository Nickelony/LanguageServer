<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Nickelony.LanguageServer.Abstractions</RootNamespace>
    <AssemblyName>Nickelony.LanguageServer.Abstractions</AssemblyName>
    <PackageId>Nickelony.LanguageServer.Abstractions</PackageId>
    <Description>Lightweight, dependency-free editor IntelliSense contracts shared by the Nickelony Language Server family.</Description>
    <PackageTags>language-server;lsp;editor;intellisense;nickelony</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>CS1591;RS0016;RS0017</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nickelony.IDEKit.IntelliSense\Nickelony.IDEKit.IntelliSense.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\Icon\LanguageServer.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
