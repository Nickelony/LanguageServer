<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Nickelony.IDEKit.AvalonEdit.IntelliSense</RootNamespace>
    <AssemblyName>Nickelony.IDEKit.AvalonEdit.IntelliSense</AssemblyName>
    <PackageId>Nickelony.IDEKit.AvalonEdit.IntelliSense</PackageId>
    <Description>AvalonEdit IntelliSense UI controllers: hover, signature help, definition navigation, completion window plumbing, and semantic-token colorizing, built on Nickelony.IDEKit.Core, .IntelliSense and .AvalonEdit.</Description>
    <PackageTags>text-editor;editor;avaloneditor;wpf;intellisense;completion;hover;signature;semantic-tokens;nickelony</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>CS1591;RS0016;RS0017</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nickelony.IDEKit.AvalonEdit\Nickelony.IDEKit.AvalonEdit.csproj" />
    <ProjectReference Include="..\Nickelony.IDEKit.IntelliSense\Nickelony.IDEKit.IntelliSense.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\Icon\LanguageServer.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
