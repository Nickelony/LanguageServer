<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Nickelony.IDEKit.IntelliSense</RootNamespace>
    <AssemblyName>Nickelony.IDEKit.IntelliSense</AssemblyName>
    <PackageId>Nickelony.IDEKit.IntelliSense</PackageId>
    <Description>Editor IntelliSense contracts, payloads, and host-state records with no third-party dependencies: code actions, completion, diagnostics, document symbols, hover, navigation, semantic tokens, and signature help.</Description>
    <PackageTags>text-editor;editor;intellisense;completion;diagnostics;hover;nickelony</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>CS1591;RS0016;RS0017</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nickelony.IDEKit.Core\Nickelony.IDEKit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\Infrastructure\NumericValidation.cs" Link="Infrastructure\NumericValidation.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\Icon\LanguageServer.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
