<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Nickelony.IDEKit.AvalonEdit.Extras</RootNamespace>
    <AssemblyName>Nickelony.IDEKit.AvalonEdit.Extras</AssemblyName>
    <PackageId>Nickelony.IDEKit.AvalonEdit.Extras</PackageId>
    <Description>Optional AvalonEdit editor extras: Markdown tooltip rendering (Markdig) and TextMate syntax-highlighting infrastructure (TextMateSharp), built on Nickelony.IDEKit.AvalonEdit.</Description>
    <PackageTags>text-editor;editor;avaloneditor;wpf;markdown;textmate;syntax-highlighting;tooltip;nickelony</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>CS1591;RS0016;RS0017</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
    <PackageReference Include="TextMateSharp" Version="2.0.3" />
    <PackageReference Include="TextMateSharp.Grammars" Version="2.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nickelony.IDEKit.AvalonEdit\Nickelony.IDEKit.AvalonEdit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\Infrastructure\BrushHelpers.cs" Link="Infrastructure\BrushHelpers.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\Icon\LanguageServer.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
