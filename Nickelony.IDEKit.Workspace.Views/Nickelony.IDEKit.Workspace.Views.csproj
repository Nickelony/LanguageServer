<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Nickelony.IDEKit.Workspace.Views</RootNamespace>
    <AssemblyName>Nickelony.IDEKit.Workspace.Views</AssemblyName>
    <PackageId>Nickelony.IDEKit.Workspace.Views</PackageId>
    <Description>Document-view coordination for the Nickelony workspace document authority: the host view contract and the manager that synchronizes attached views with tracked documents.</Description>
    <PackageTags>text-editor;editor;documents;workspace;views;nickelony</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>CS1591;RS0016;RS0017</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nickelony.IDEKit.Core\Nickelony.IDEKit.Core.csproj" />
    <ProjectReference Include="..\Nickelony.IDEKit.Workspace\Nickelony.IDEKit.Workspace.csproj" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\Icon\LanguageServer.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
